{
  "name": "King-Crack",
  "version": "0.1",
  "description": "检测是否存在VUE框架并且强制注入路由守卫、提取API",
  "manifest_version": 3,
    "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon256.png",
      "48": "icons/icon256.png",
      "128": "icons/icon256.png"
    }
  },
  "icons": {
    "16": "icons/icon256.png",
    "48": "icons/icon256.png",
    "128": "icons/icon256.png",
    "256": "icons/icon256.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["detector.js", "api-extractor.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
